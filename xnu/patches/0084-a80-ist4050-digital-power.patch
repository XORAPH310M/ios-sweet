+/* The R1Q DT connects the panel digital enable to PCAL6524 P0_1. */
+static int
+a80_panel_digital_enable(void)
+{
+    int error = sweet_rpmh_vreg_enable("ldoa10", 1720);
+    if (error) {
+        return error;
+    }
+    touch_wait(20);
+    a80_sda = 46;
+    a80_scl = 47;
+    const uint8_t out_reg = 0x04;
+    const uint8_t cfg_reg = 0x0c;
+    uint8_t out = 0, cfg = 0;
+    error = a80_ist40xx_transfer(0x22, &out_reg, 1, &out, 1);
+    if (!error) {
+        error = a80_ist40xx_transfer(0x22, &cfg_reg, 1, &cfg, 1);
+    }
+    if (!error) {
+        const uint8_t set_output[] = {out_reg, (uint8_t)(out | 2u)};
+        error = a80_ist40xx_transfer(0x22, set_output, 2, NULL, 0);
+    }
+    if (!error) {
+        const uint8_t set_direction[] = {cfg_reg, (uint8_t)(cfg & ~2u)};
+        error = a80_ist40xx_transfer(0x22, set_direction, 2, NULL, 0);
+    }
+    if (!error) {
+        error = a80_ist40xx_transfer(0x22, &out_reg, 1, &out, 1);
+    }
+    if (!error) {
+        error = a80_ist40xx_transfer(0x22, &cfg_reg, 1, &cfg, 1);
+    }
+    a80_sda = 6;
+    a80_scl = 7;
+    printf("A80 IST40XX: PCAL6524 out=%#x cfg=%#x error=%d\n", out, cfg, error);
+    return error ? error : ((out & 2u) && !(cfg & 2u) ? 0 : EIO);
+}
