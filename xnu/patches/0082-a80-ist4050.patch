diff --git a/bsd/dev/ist40xx-geni.h b/bsd/dev/ist40xx-geni.h
new file mode 100644
index 0000000..1a9eba9
--- /dev/null
+++ b/bsd/dev/ist40xx-geni.h
@@ -0,0 +1,60 @@
+#ifndef A80_IST40XX_GENI_H
+#define A80_IST40XX_GENI_H
+
+#include "ist40xx-report.h"
+
+/* The transport must send the four address bytes, a repeated START,
+ * then read the response from the same I2C slave.
+ */
+typedef int (*ist40xx_transfer)(uint8_t slave, const uint8_t *address,
+                               unsigned address_size, uint8_t *response,
+                               unsigned response_size);
+
+static inline int
+ist40xx_read_word(ist40xx_transfer transfer, uint32_t reg, uint8_t word[4])
+{
+    const uint8_t address[] = {reg >> 24, reg >> 16, reg >> 8, reg};
+    return transfer(0x50, address, sizeof(address), word, 4);
+}
+
+static inline int
+ist40xx_read_chip_id(ist40xx_transfer transfer, uint32_t *chip_id)
+{
+    uint8_t word[4];
+    int error = ist40xx_read_word(transfer, UINT32_C(0xc0001000), word);
+    if (error == 0) {
+        *chip_id = ((uint32_t)word[0] << 24) | ((uint32_t)word[1] << 16)
+                 | ((uint32_t)word[2] << 8) | word[3];
+    }
+    return error;
+}
+
+/* Run when the board IRQ is asserted, after successful chip identification.
+ * Collect the entire report before mutating contact state.
+ */
+static inline int
+ist40xx_read_report(ist40xx_transfer transfer, struct ist40xx_touch_state *state,
+                    void (*emit)(int, int, int, int))
+{
+    uint8_t status[4];
+    int error = ist40xx_read_word(transfer, UINT32_C(0xb00b0104), status);
+    if (error != 0) {
+        return error;
+    }
+    unsigned count = status[2] >> 4;
+    if (count > IST40XX_CONTACTS) {
+        return -1;
+    }
+    uint8_t records[IST40XX_CONTACTS * IST40XX_RECORD_BYTES] = {0};
+    for (unsigned index = 0; index < count; ++index) {
+        error = ist40xx_read_word(transfer,
+                                  UINT32_C(0xb00b0108) + index * IST40XX_RECORD_BYTES,
+                                  records + index * IST40XX_RECORD_BYTES);
+        if (error != 0) {
+            return error;
+        }
+    }
+    return ist40xx_dispatch_report(state, records, count, emit) ? 0 : -1;
+}
+
+#endif
diff --git a/bsd/dev/ist40xx-report.h b/bsd/dev/ist40xx-report.h
new file mode 100644
index 0000000..23bc134
--- /dev/null
+++ b/bsd/dev/ist40xx-report.h
@@ -0,0 +1,81 @@
+#ifndef A80_IST40XX_REPORT_H
+#define A80_IST40XX_REPORT_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+enum {
+    IST40XX_CONTACTS = 10,
+    IST40XX_RECORD_BYTES = 8,
+    IST40XX_X_LIMIT = 1080,
+    IST40XX_Y_LIMIT = 2400,
+};
+
+struct ist40xx_contact {
+    unsigned slot;
+    bool down;
+    unsigned x;
+    unsigned y;
+};
+
+/* Decode one four-byte coordinate word from an eight-byte record.
+ * Release events require the caller's last known position for the slot.
+ */
+static inline bool
+ist40xx_decode_contact(const uint8_t wire[4], struct ist40xx_contact *contact)
+{
+    unsigned id = wire[0] >> 4;
+    unsigned event = wire[0] & 0xf;
+    unsigned x = ((unsigned)wire[1] << 4) | (wire[2] >> 4);
+    unsigned y = ((unsigned)(wire[2] & 0xf) << 8) | wire[3];
+
+    if (id == 0 || id > IST40XX_CONTACTS || (event != 1 && event != 2)) {
+        return false;
+    }
+    if (event == 1 && (x >= IST40XX_X_LIMIT || y >= IST40XX_Y_LIMIT)) {
+        return false;
+    }
+    *contact = (struct ist40xx_contact) {
+        .slot = id - 1,
+        .down = event == 1,
+        .x = event == 1 ? x : 0,
+        .y = event == 1 ? y : 0,
+    };
+    return true;
+}
+
+struct ist40xx_touch_state {
+    struct ist40xx_contact slots[IST40XX_CONTACTS];
+};
+
+/* Call only for a complete interrupt report. Missing slots stay active
+ * until the controller sends their release event.
+ */
+static inline bool
+ist40xx_dispatch_report(struct ist40xx_touch_state *state,
+                        const uint8_t *records, unsigned count,
+                        void (*emit)(int, int, int, int))
+{
+    if (count > IST40XX_CONTACTS) {
+        return false;
+    }
+    for (unsigned index = 0; index < count; ++index) {
+        struct ist40xx_contact contact;
+        if (!ist40xx_decode_contact(records + index * IST40XX_RECORD_BYTES,
+                                    &contact)) {
+            continue;
+        }
+        struct ist40xx_contact *slot = &state->slots[contact.slot];
+        if (contact.down) {
+            *slot = contact;
+        } else if (slot->down) {
+            slot->down = false;
+        } else {
+            continue;
+        }
+        emit(slot->slot, slot->down, slot->x, slot->y);
+    }
+    return true;
+}
+
+#endif
