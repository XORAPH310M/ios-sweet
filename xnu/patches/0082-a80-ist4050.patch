+
+static struct ist40xx_touch_state a80_touch_state;
+
+static int
+a80_ist40xx_transfer(uint8_t slave, const uint8_t *address, unsigned address_size,
+    uint8_t *response, unsigned response_size)
+{
+    int error = touch_msg(slave, address, address_size, NULL, 0, true);
+    return error ? error : touch_msg(slave, NULL, 0, response, response_size, false);
+}
+
+static void
+a80_ist40xx_release(void)
+{
+    for (unsigned i = 0; i < IST40XX_CONTACTS; ++i) {
+        struct ist40xx_contact *slot = &a80_touch_state.slots[i];
+        if (slot->down) {
+            sweet_hid_touch(slot->slot, 0, slot->x, slot->y);
+            slot->down = false;
+        }
+    }
+}
+
+static void
+a80_ist40xx_run(void)
+{
+    int power_error = sweet_rpmh_vreg_enable("ldoa18", 3000);
+    if (power_error) {
+        printf("A80 IST40XX: L18 enable error=%d\n", power_error);
+        return;
+    }
+    touch_wait(100);
+    uint32_t id = 0;
+    int irq_active_low = 1;
+    (void)PE_parse_boot_argn("a80istirqlo", &irq_active_low, sizeof(irq_active_low));
+    int error = ist40xx_read_chip_id(a80_ist40xx_transfer, &id);
+    printf("A80 IST40XX: chip=%#x error=%d gpio9=%u irq-low=%d\n",
+        id, error, touch_rd(st.gpio, TOUCH_GPIO_IO(9)) & 1u, !!irq_active_low);
+    if (error || id != 0x4050u) {
+        return;
+    }
+    unsigned failures = 0;
+    while (!st.dead && failures < 10) {
+        bool irq_high = (touch_rd(st.gpio, TOUCH_GPIO_IO(9)) & 1u) != 0;
+        if (irq_high != (irq_active_low != 0)) {
+            error = ist40xx_read_report(a80_ist40xx_transfer,
+                &a80_touch_state, sweet_hid_touch);
+            if (error) {
+                if (failures++ == 0) {
+                    printf("A80 IST40XX: report error=%d\n", error);
+                }
+            } else {
+                failures = 0;
+            }
+        }
+        touch_wait(10);
+    }
+    a80_ist40xx_release();
+}
+
