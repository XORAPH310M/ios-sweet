         return;
     }
     unsigned failures = 0;
-    while (!st.dead && failures < 10) {
+    while (!st.dead) {
         bool irq_high = (touch_rd(st.gpio, TOUCH_GPIO_IO(9)) & 1u) != 0;
         if (irq_high != (irq_active_low != 0)) {
             error = ist40xx_read_report(a80_ist40xx_transfer,
                 &a80_touch_state, sweet_hid_touch);
             if (error) {
-                if (failures++ == 0) {
+                if (failures == 0 || failures == 9) {
                     printf("A80 IST40XX: report error=%d\n", error);
                 }
+                if (++failures == 10) {
+                    a80_ist40xx_release();
+                }
+                touch_wait(30);
             } else {
                 failures = 0;
             }
